<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Description</key>
	<string>Erstellt ein PKG aus dem geladenen DMG und versieht es mit Versionsnummer und Architektur im Namen.</string>
	<key>Identifier</key>
	<string>com.github.emetriq.autopkg.pdfsambasic.pkg</string>
	<key>Input</key>
	<dict>
		<key>ARCH_TOKEN</key>
		<string>arm64</string>
		<key>BUNDLE_ID</key>
		<string>org.pdfsam.basic</string>
		<key>NAME</key>
		<string>PDFsam Basic</string>
	</dict>
	<key>MinimumVersion</key>
	<string>2.3</string>
	<key>ParentRecipe</key>
	<string>com.github.emetriq.autopkg.pdfsambasic.download</string>
	<key>Process</key>
	<array>
		<dict>
			<key>Arguments</key>
			<dict>
				<key>dmg_path</key>
				<string>%pathname%</string>
			</dict>
			<key>Processor</key>
			<string>AppDmgVersioner</string>
		</dict>
		<dict>
			<key>Arguments</key>
			<dict>
				<key>app_path</key>
				<string>%pathname%/PDFsam Basic.app</string>
				<key>bundleid</key>
				<string>%BUNDLE_ID%</string>
				<key>pkg_path</key>
				<string>%RECIPE_CACHE_DIR%/PDFsamBasic-%version%-%ARCH_TOKEN%.pkg</string>
				<key>version</key>
				<string>%version%</string>
			</dict>
			<key>Processor</key>
			<string>AppPkgCreator</string>
		</dict>
	</array>
</dict>
</plist>
