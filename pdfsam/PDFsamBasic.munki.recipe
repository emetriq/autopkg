<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Description</key>
	<string>Importiert das PKG in ein Munki-Repository.</string>
	<key>Identifier</key>
	<string>com.github.emetriq.autopkg.pdfsambasic.munki</string>
	<key>ParentRecipe</key>
	<string>com.github.emetriq.autopkg.pdfsambasic.pkg</string>
	<key>MinimumVersion</key>
	<string>2.3</string>
	<key>Input</key>
	<dict>
		<key>NAME</key>
		<string>PDFsam Basic</string>
		<key>MUNKI_REPO_SUBDIR</key>
		<string>apps/PDFsamBasic</string>
		<!-- Für Munki-Arch-Filter: arm64 oder x86_64 -->
		<key>MUNKI_SUPPORTED_ARCH</key>
		<string>arm64</string>
		<key>pkginfo</key>
		<dict>
			<key>name</key>
			<string>PDFsamBasic</string>
			<key>display_name</key>
			<string>PDFsam Basic</string>
			<key>description</key>
			<string>PDF Split &amp; Merge (Open Source).</string>
			<key>developer</key>
			<string>Andrea Vacondio</string>
			<key>minimum_os_version</key>
			<string>11.0.0</string>
			<key>supported_architectures</key>
			<array>
				<string>%MUNKI_SUPPORTED_ARCH%</string>
			</array>
			<key>unattended_install</key>
			<true/>
		</dict>
	</dict>
	<key>Process</key>
	<array>
		<dict>
			<key>Processor</key>
			<string>MunkiImporter</string>
			<key>Arguments</key>
			<dict>
				<key>pkg_path</key>
				<string>%pkg_path%</string>
				<key>repo_subdirectory</key>
				<string>%MUNKI_REPO_SUBDIR%</string>
			</dict>
		</dict>
	</array>
</dict>
</plist>
